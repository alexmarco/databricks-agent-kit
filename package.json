{
  "name": "databricks-agent-kit",
  "version": "0.1.0",
  "description": "MCP server that gives coding agents governed SQL and Unity Catalog metadata access to Databricks.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "bin": {
    "dak": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "prepare": "husky",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/**/*.test.ts\"",
    "test:integration": "node --disable-warning=ExperimentalWarning --test \"test/integration/*.it.ts\""
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "commander": "^15.0.0",
    "parquet-wasm": "0.9.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@modelcontextprotocol/client": "^2.3.1",
    "@types/node": "^26.6.5",
    "husky": "9.1.7",
    "typescript": "^7.0.2"
  }
}
